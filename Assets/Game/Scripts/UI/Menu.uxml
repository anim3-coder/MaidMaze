    <ui:VisualElement name="List" picking-mode="Position" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: stretch; width: 15%; flex-wrap: nowrap; right: 59px; bottom: 0; top: 0; left: 0; position: relative; align-self: flex-end; align-content: stretch; margin-right: 60px; margin-top: 30px; margin-bottom: 30px; margin-left: 30px; padding-right: 0; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s;">
