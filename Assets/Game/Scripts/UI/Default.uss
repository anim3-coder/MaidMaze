:root {
}

.default-button {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(255, 126, 190);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    background-position-y: center;
    background-position-x: center;
    font-size: 24px;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 5px;
    text-shadow: 2px 2px 2px rgb(165, 83, 124);
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    letter-spacing: 5px;
    -unity-paragraph-spacing: 143px;
    transition-duration: 100ms;
    transition-delay: 0ms;
    padding-bottom: 10px;
    margin-bottom: 20px;
    text-overflow: clip;
    transition-timing-function: ease-out-bounce;
}

.default-button:hover {
    scale: 1.1 1.1 1.1;
    transition-duration: 100ms;
    transition-delay: 0ms;
    background-color: rgb(204, 101, 152);
    color: rgb(242, 242, 242);
    -unity-text-outline-color: rgb(242, 242, 242);
    border-left-color: rgb(242, 242, 242);
    border-right-color: rgb(242, 242, 242);
    border-top-color: rgb(242, 242, 242);
    border-bottom-color: rgb(242, 242, 242);
    transition-timing-function: ease-out-bounce;
}

.Logo {
    color: rgb(255, 255, 255);
    border-top-width: 40px;
    border-right-width: 40px;
    border-bottom-width: 40px;
    border-left-width: 40px;
    border-left-color: rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgb(153, 153, 153);
    -unity-font-style: bold;
    font-size: 36px;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: space-around;
    align-self: center;
    align-content: flex-start;
    -unity-text-align: middle-center;
    text-overflow: clip;
    white-space: nowrap;
    text-shadow: 5px 5px 0 rgb(255, 126, 190);
}

.reference-button {
    scale: 1 1;
    transform-origin: center;
    align-self: flex-end;
    background-color: rgba(255, 255, 255, 0);
    width: auto;
    height: auto;
    aspect-ratio: 1;
    max-height: none;
    border-top-width: 0;
    border-left-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.reference-button:hover {
    transition-duration: 100s;
    transition-timing-function: ease-out-bounce;
    background-color: rgb(255, 126, 190);
}

.pause-button:hover {
    -unity-background-image-tint-color: rgb(255, 126, 190);
    transition-timing-function: ease-out-bounce;
    transition-duration: 100ms;
}

.chat-scroll {
    position: absolute;
    bottom: 40px;
    left: 40px;
    width: 400px;
    height: 400px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
}

.chat-scroll .unity-scroll-view__content-container {
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    padding: 8px;
}

.chat-scroll .unity-scroll-view__content-viewport {
    justify-content: flex-end;
    align-items: stretch;
}

.chat-scroll .unity-scroller--vertical {
    width: 10px;
    background-color: rgba(255, 255, 255, 0.2);
}

.chat-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.3);
}

.chat-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 5px;
}

.chat-content > .chat-message {
    background-color: rgba(255, 255, 255, 0.9);
    color: black;
    font-size: 14px;
    padding: 6px 10px;
    margin-bottom: 6px;
    border-radius: 12px;
    white-space: normal;
    max-width: 100%;
}

.chat-content > .chat-message.me {
    background-color: rgb(76, 175, 80);
    color: white;
    align-self: flex-end;
}

.Hand-button {
    flex-grow: 1;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-position-x: center;
    background-position-y: center;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 0;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-left: 0;
    margin-bottom: 0;
    margin-right: 0;
    border-top-left-radius: 25px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.Hand-button:hover {
    background-color: rgba(0, 0, 0, 0.25);
    -unity-background-image-tint-color: rgb(191, 191, 191);
}

.unity-base-dropdown__container-outer {
    background-color: rgba(40, 40, 40, 0.95);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(255, 126, 190);
    overflow: hidden;
    margin-top: 4px;
}

.unity-base-dropdown__container-inner {
    background-color: transparent;
    padding: 4px 0;
}

.unity-base-dropdown__container-inner .unity-scroller--vertical {
    width: 8px;
    background-color: rgba(0, 0, 0, 0.3);
}

.unity-base-dropdown__container-inner .unity-scroller__track {
    background-color: rgb(255, 126, 190);
    border-radius: 4px;
}

.unity-base-dropdown__item {
    padding: 8px 16px;
    font-size: 18px;
    color: white;
    background-color: transparent;
    transition: background-color 0.15s;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(255, 126, 190, 0.3);
}

.unity-base-dropdown__item--selected {
    background-color: rgba(255, 126, 190, 0.6);
    color: white;
}

.default-text-field {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    background-color: rgb(255, 126, 190);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    background-position-y: center;
    background-position-x: center;
    font-size: 24px;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 5px;
    text-shadow: 2px 2px 2px rgb(165, 83, 124);
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    letter-spacing: 5px;
    -unity-paragraph-spacing: 143px;
    transition-duration: 100ms;
    transition-delay: 0ms;
    transition-timing-function: ease-out-bounce;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 20px;
    text-overflow: clip;
    white-space: normal;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
}

.default-text-field .unity-text-field__input {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    font-size: 24px;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 5px;
    text-shadow: 2px 2px 2px rgb(165, 83, 124);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.default-text-field .unity-text-field__input .unity-text-element--placeholder {
    color: rgba(255, 255, 255, 0.6);
    -unity-text-outline-width: 3px;
}

.default-text-field:focus {
    border-left-color: rgb(255, 220, 235);
    border-right-color: rgb(255, 220, 235);
    border-top-color: rgb(255, 220, 235);
    border-bottom-color: rgb(255, 220, 235);
}

.default-text-field:hover {
    background-color: rgb(255, 145, 200);
}

.default-text-field:disabled {
    background-color: rgb(180, 100, 140);
    opacity: 0.6;
}
