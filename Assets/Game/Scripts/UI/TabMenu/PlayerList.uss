.player-list-container {
    background-color: rgba(20, 20, 30, 0.9);
    border-radius: 12px;
    padding: 16px;
    width: 300px;
    max-height: 500px;
    border-width: 1px;
    border-color: #444;
}

.player-list-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 12px;
    text-align: center;
}

.player-entry {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    margin-bottom: 8px;
    background-color: #2a2a3a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3a3a4a;
}

.player-avatar {
    width: 40px;
    height: 40px;
    background-color: #555;
    border-radius: 20px;
    margin-right: 12px;
}

.player-info {
    flex-grow: 1;
    flex-direction: column;
}

.player-name {
    font-size: 16px;
    color: #ffffff;
    -unity-font-style: bold;
}

.player-status {
    font-size: 12px;
    color: #4caf50;
    margin-top: 2px;
}