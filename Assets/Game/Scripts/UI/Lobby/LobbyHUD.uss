/* ─── Корневой контейнер на весь экран ────────────────── */
.lobby-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: space-between;
}

/* ─── Общий стиль HUD-плашек (в стиле Chat.uss) ───────── */
.hud-badge {
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 0;
    padding: 6px 12px;
    flex-direction: row;
    align-items: center;
}

.hud-text {
    color: rgb(255, 255, 255);
    font-size: 16px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* ─── Верх: счётчик игроков ───────────────────────────── */
.top-container {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.players-text {
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ─── Низ справа: код лобби ──────────────────────────── */
.bottom-right-container {
    position: absolute;
    right: 12px;
    bottom: 12px;
    flex-direction: column;
    align-items: flex-end;
}

.lobby-code-button {
    margin: 0;
    transition-duration: 0.1s;
}

.lobby-code-button:hover {
    background-color: rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.7);
}

.lobby-code-button:active {
    background-color: rgba(255, 255, 255, 0.2);
}

.lobby-code-title {
    color: rgba(255, 255, 255, 0.75);
    margin-right: 6px;
}

.lobby-code-value {
    color: rgb(255, 255, 85);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* ─── Всплывающая подсказка при копировании ───────────── */
.copy-hint {
    color: rgb(85, 255, 85);
    font-size: 13px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
    margin-bottom: 4px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.copy-hint--visible {
    opacity: 1;
}